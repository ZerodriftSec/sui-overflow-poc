OPENROUTER_API_KEY=

# VITE_ prefix exposes values to the browser bundle in dev
# Credential source: "env" (read secrets from .env) or "settings" (read from saved Settings UI)
VITE_CREDENTIAL_SOURCE=settings
VITE_OPENROUTER_API_KEY=

# Optional override for deployed content vault package (defaults to testnet ID in src/constants.ts)
VITE_VAULT_PACKAGE_ID=

# Optional Walrus publisher URL override (defaults to walrus.space testnet publisher)
VITE_WALRUS_PUBLISHER_URL=

# Enoki zkLogin (public API key + OAuth client IDs from Enoki Portal)
VITE_ENOKI_PUBLIC_API_KEY=
VITE_ENOKI_GOOGLE_CLIENT_ID=
# Must match Authorized redirect URIs in Google Cloud Console exactly.
# Dev: http://localhost:5173
# Vercel: https://your-app.vercel.app
VITE_ENOKI_REDIRECT_URL=http://localhost:5173
# VITE_ENOKI_FACEBOOK_CLIENT_ID=
# VITE_ENOKI_TWITCH_CLIENT_ID=

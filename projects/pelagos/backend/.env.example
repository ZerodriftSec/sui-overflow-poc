PORT=13101
MONITOR_PORT=13102
STATE_DIR=./state
FRONTEND_URL=http://localhost:13100
POLYMARKET_API_URL=https://clob.polymarket.com

# Set LOG_LEVEL=debug to emit high-volume per-request and per-bundle/per-trade
# diagnostic logs. Leave unset in production (Akash) to keep logs clean; 4xx/5xx
# warnings, the cron cycle summary, and startup lines are always logged.
LOG_LEVEL=
FAUCET_GLOBAL_HOURLY_LIMIT=12
DUSDC_GRANT_MAX_UI=25
MUSDC_GRANT_UI=10000
SUI_GRANT_MIST=3000000000

# Sui testnet deployment
SUI_NETWORK=testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
SUI_GRAPHQL_URL=https://graphql.testnet.sui.io/graphql
SUI_CLI=sui
SUI_KEYSTORE_PATH=/path/to/.sui/sui_config
SUI_ACTIVE_ADDRESS=0x78f0be0d03f277c11d696436a3dd2f02c02f9cce118f6c0286fbc701a29ec411
SUI_PACKAGE_ID=0x598434be38a69bf97b70490d320a698445990de38eb36e2f4c9d41dbe1ff3e45
SUI_MARKET_MODULE=prediction_market
SUI_MARKET_ADMIN_CAP_ID=0x450d3450381a1f0fcbfbc0c354b8af4e7d0e7f732591bd6db57d5c14bf01105d
# Sui signer for backend-submitted txs (faucet / admin mint). Set to YOUR OWN
# testnet key locally — NEVER commit a real key. Format: suiprivkey1... (Bech32).
SUI_PRIVATE_KEY=

# Testnet mock-USDC mint authority. The local Sui key that owns this TreasuryCap
# can mint test mUSDC; do not commit private keys or recovery phrases.
MOCK_USDC_TYPE=0x598434be38a69bf97b70490d320a698445990de38eb36e2f4c9d41dbe1ff3e45::mock_usdc::MOCK_USDC
MOCK_USDC_TREASURY_CAP_ID=0x16b34adda0f968ab481449d55f445d3598e0a617f2d6a83d62e84907be534aa1
MOCK_USDC_METADATA_ID=0x952435fcae9412796ddf2a9f0e173c9a2caba7b2f26079714a9e1a3bfd33a287
MOCK_USDC_DECIMALS=6

# Pelagos-operated DeepBook Predict testnet deployment. The checked-in manifest
# supplies package/object/oracle IDs; env IDs below are optional explicit pins.
PREDICT_NETWORK=testnet
PREDICT_MODE=managed
PREDICT_DEPLOYMENT_MANIFEST=./config/predict-managed.testnet.json
PREDICT_SERVER_URL=direct+sui://testnet
PREDICT_PACKAGE_ID=0xf5716c88594bb34e89350717bc5938b0879f63262eedcb8cb1064d512563cb34
PREDICT_OBJECT_ID=0xc075248dc9e51527229564e37416d816e01df046ba77ce167151362a74fa9794
PREDICT_DUSDC_TYPE=0xe95040085976bfd54a1a07225cd46c8a2b4e8e2b6732f140a0fc49850ba73e1a::dusdc::DUSDC
PREDICT_SIGNER_PRIVATE_KEY=
PREDICT_FEED_ENABLED=true
PREDICT_FEED_INTERVAL_MS=10000
PREDICT_OPEN_GAS_BUDGET_MIST=2500000000

# Optional services. Leave empty for the local Sui harness.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# ANTHROPIC_API_KEY — no longer used (the AI portfolio composer route and its
# @anthropic-ai/sdk dependency were removed). Kept commented for reference only.
# ANTHROPIC_API_KEY=

# Pelagos on-chain vault (pelagos_vault::vault, generic Vault<MOCK_USDC>)
VAULT_PACKAGE_ID=0xa88c4e60aeb45927607e9de932f6ae8982b6fe2452891cf32ae643be90cdb670
VAULT_OBJECT_ID=0xeb8402f9f18c1762cae4bd8dc09acb73f51abd55d34c8cd4d0059d4c7181e3fd
VAULT_ADMIN_CAP_ID=0xafe1cf30b8ee3ef4c1f15b984681e50eb9f521e3381803d7445bb3d651d21801
